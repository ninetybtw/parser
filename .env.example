# Скопируй в .env и заполни. Все поля, кроме LEADGEN_DATA_DIR, необязательны:
# источник без ключей просто не подключается.

LEADGEN_DATA_DIR=./data

# --- ВКонтакте (официальный API) ---
# Пользовательский токен (groups.search работает только с ним). Права: groups, market, offline.
VK_TOKEN=
VK_API_VERSION=5.199
# id города из database.getCities (1 — Москва, 2 — Санкт-Петербург); пусто — без фильтра
VK_CITY_ID=
# 1 — подтягивать товары/услуги сообщества (market.get) как прайс; +1 запрос на группу
VK_FETCH_MARKET=1

# --- Telegram (MTProto через Telethon, только чтение) ---
# Ключи берутся на https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
TG_SESSION=./data/telegram

# --- Биржи (RSS) ---
# Формат: имя=шаблон_url;имя2=шаблон2. {query} заменяется на поисковую фразу.
# Если в адресе нет {query} (лента всех заказов), заказы фильтруются по словам ниши.
# Проверь, что лента открывается в браузере: адреса бирж меняются.
LEADGEN_RSS_FEEDS=fl=https://www.fl.ru/rss/all.xml?category=-1

# --- Генерация предложений (Claude API) ---
# Без ключа предложения собираются из шаблонов ниши.
ANTHROPIC_API_KEY=
LEADGEN_MODEL=claude-opus-5-5
LEADGEN_EFFORT=medium

# --- О тебе (подставляется в предложения) ---
ME_NAME=Иван
ME_SERVICES=сайты-визитки и лендинги, Telegram-боты для записи и заказов, интеграция с CRM
ME_PORTFOLIO=https://example.com/portfolio
ME_CONTACT=@your_tg

# Мягкий дневной лимит отправок: после него интерфейс предупреждает
LEADGEN_DAILY_SEND_LIMIT=20
