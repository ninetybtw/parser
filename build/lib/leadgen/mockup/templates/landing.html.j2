<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ lead.name }} — концепт сайта</title>
<style>
  :root {
    --primary: {{ palette.primary }};
    --primary-dark: {{ palette.primary_dark }};
    --accent: {{ palette.accent }};
    --on-primary: {{ palette.on_primary }};
    --soft: {{ palette.soft }};
    --text: #1f2328;
    --muted: #5b636e;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--text); background: #fff; line-height: 1.5; }
  .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .badge { background: #111; color: #fff; text-align: center; font-size: 13px; padding: 6px 12px; }
  header { border-bottom: 1px solid #eee; }
  header .wrap { display: flex; align-items: center; gap: 14px; min-height: 72px; flex-wrap: wrap; }
  header img { width: 48px; height: 48px; object-fit: contain; border-radius: 10px; }
  header .name { font-weight: 700; font-size: 18px; }
  header .phone { margin-left: auto; font-weight: 600; color: var(--primary-dark); text-decoration: none; }
  .hero { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: var(--on-primary); padding: 72px 0; }
  .hero h1 { font-size: clamp(28px, 4vw, 44px); line-height: 1.15; margin: 0 0 16px; max-width: 720px; }
  .hero p { font-size: 18px; opacity: .9; margin: 0 0 28px; max-width: 620px; }
  .btn { display: inline-block; background: #fff; color: var(--primary-dark); font-weight: 700; padding: 14px 26px; border-radius: 12px; text-decoration: none; }
  section { padding: 56px 0; }
  h2 { font-size: 28px; margin: 0 0 24px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .card { border: 1px solid #e7e9ec; border-radius: 14px; padding: 20px; background: #fff; }
  .card .price { color: var(--primary-dark); font-weight: 700; margin-top: 8px; font-size: 18px; }
  .soft { background: var(--soft); }
  .placeholder { border: 2px dashed #c9ced6; border-radius: 14px; padding: 28px; color: var(--muted); text-align: center; }
  .contacts { display: flex; gap: 24px; flex-wrap: wrap; }
  footer { padding: 28px 0; color: var(--muted); font-size: 14px; border-top: 1px solid #eee; }
</style>
</head>
<body>
<div class="badge">Концепт-превью для «{{ lead.name }}» · черновик, не опубликован</div>
<header>
  <div class="wrap">
    {% if logo %}<img src="{{ logo }}" alt="">{% endif %}
    <span class="name">{{ lead.name }}</span>
    {% if phone %}<a class="phone" href="tel:{{ phone }}">{{ phone }}</a>{% endif %}
  </div>
</header>

<div class="hero">
  <div class="wrap">
    <h1>{{ profile.hero_tagline }}</h1>
    <p>{% if lead.city %}{{ lead.city }} · {% endif %}{{ profile.title }}</p>
    <a class="btn" href="#contacts">{{ profile.cta }}</a>
  </div>
</div>

<section>
  <div class="wrap">
    {% if prices %}
    <h2>Услуги и цены</h2>
    <div class="grid">
      {% for item in prices %}
      <div class="card"><div>{{ item.title }}</div>{% if item.price %}<div class="price">{{ item.price }}</div>{% endif %}</div>
      {% endfor %}
    </div>
    {% else %}
    <h2>Что будет на сайте</h2>
    <div class="grid">
      {% for item in services %}<div class="card">{{ item.title }}</div>{% endfor %}
    </div>
    {% endif %}
  </div>
</section>

<section class="soft">
  <div class="wrap">
    <h2>Отзывы клиентов</h2>
    <div class="placeholder">Здесь будут ваши реальные отзывы — подтянем из сообщества или карт</div>
  </div>
</section>

<section id="contacts">
  <div class="wrap">
    <h2>{{ profile.cta }}</h2>
    <div class="contacts">
      {% if phone %}<div><strong>Телефон</strong><br>{{ phone }}</div>{% endif %}
      {% if email %}<div><strong>E-mail</strong><br>{{ email }}</div>{% endif %}
      {% if lead.city %}<div><strong>Город</strong><br>{{ lead.city }}</div>{% endif %}
    </div>
    <div class="placeholder" style="margin-top:24px">Форма заявки / онлайн-записи</div>
  </div>
</section>

<footer><div class="wrap">© {{ lead.name }}</div></footer>
</body>
</html>
